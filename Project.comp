compee: 1
data: src/Racers/Content/data
build:
  validate: tools/cli.sh yaml validate src/Racers/Content --quiet
  targets:
    - name: macOS
      command: dotnet build hosts/Desktop -nologo -v:q -clp:NoSummary
      run: hosts/Desktop/bin/Debug/net10.0/Racers
    - name: Web
      command: dotnet publish hosts/Browser -c Debug -o artifacts/browser-debug -nologo -v:q -clp:NoSummary
      serve: artifacts/browser-debug/wwwroot
blocks:
  - name: Meta
    properties:
      - name: Group
        type: select
        width: 118
        options:
          group: Groups
      - name: Enabled
        type: boolean
        width: 56
  - name: Unit
    properties:
      - name: IsUnit
        type: boolean
        width: 71
  - name: Sprite
    properties:
      - name: Path
        type: asset
        width: 181
        root: src/Racers/Content/sprites
        extensions: false
      - name: Color
        type: color
        width: 104
      - name: Animated
        type: boolean
        width: 68
      - name: FPS
        type: integer
        width: 44
  - name: Rive
    properties:
      - name: Path
        type: asset
        width: 192
        root: src/Racers/Content/rives
        extensions: false
      - name: Artboard
        width: 178
      - name: Layout
        type: boolean
        width: 56
hiddenGroups: [Groups]
rows: [Groups, Buttons, Screens, Misc, Cell, Menu, Car, CloudyRoad, UI_TopSpeed]
