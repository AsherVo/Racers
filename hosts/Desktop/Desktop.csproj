<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows, macOS (no Catalyst) and Linux: a plain .NET app, published with NativeAOT. -->
  <PropertyGroup>
    <!-- WinExe: no console window on Windows. Makes no difference on macOS or Linux. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Racers</AssemblyName>
    <RootNamespace>Desktop</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Racers\Racers.Game.csproj" />
    <!-- Each package only contributes natives for its own RIDs. -->
    <PackageReference Include="SDL3-CS.MacOS" />
    <PackageReference Include="SDL3-CS.Windows" />
    <PackageReference Include="SDL3-CS.Linux" />
  </ItemGroup>

  <!-- Fonts and Rive (tools/build-native-macos.sh). P/Invoke finds it next to the executable. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="$(MSBuildThisFileDirectory)../../artifacts/native/osx/libEngineNative.dylib"
          Link="libEngineNative.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(GameContentDir)**" LinkBase="Content" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
