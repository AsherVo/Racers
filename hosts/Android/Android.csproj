<Project Sdk="Microsoft.NET.Sdk">

  <!-- Android host: SDL's Java SDLActivity (bound by SDL3-CS.Android) calls MainActivity.Main(). -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Racers.Android</AssemblyName>
    <RootNamespace>AndroidHost</RootNamespace>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.example.Racers</ApplicationId>
    <ApplicationTitle>Hello Sprite</ApplicationTitle>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Without these, builds fall back to the legacy Xamarin SDK folder, which lacks the API level this targets,
       and to the system's default JDK, which can be older than the 17 the Android tools need. -->
  <PropertyGroup Condition="'$(AndroidSdkDirectory)' == ''">
    <AndroidSdkDirectory Condition="'$(ANDROID_HOME)' != ''">$(ANDROID_HOME)</AndroidSdkDirectory>
    <AndroidSdkDirectory Condition="'$(ANDROID_HOME)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Android/sdk</AndroidSdkDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JavaSdkDirectory)' == ''">
    <JavaSdkDirectory Condition="'$(JAVA_HOME)' != ''">$(JAVA_HOME)</JavaSdkDirectory>
    <JavaSdkDirectory Condition="'$(JAVA_HOME)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Java/jdk-17</JavaSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Racers\Racers.Game.csproj" />
    <PackageReference Include="SDL3-CS.Android" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDL resolves relative paths against APK assets. -->
    <AndroidAsset Include="$(GameContentDir)**" Link="Assets/Content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
