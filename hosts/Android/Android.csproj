<Project Sdk="Microsoft.NET.Sdk">

  <!-- Android host: SDL's Java SDLActivity (bound by SDL3-CS.Android) calls MainActivity.Main(). -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>HelloSprite.Android</AssemblyName>
    <RootNamespace>AndroidHost</RootNamespace>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.example.hellosprite</ApplicationId>
    <ApplicationTitle>Hello Sprite</ApplicationTitle>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HelloSprite\HelloSprite.Game.csproj" />
    <PackageReference Include="SDL3-CS.Android" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDL resolves relative paths against APK assets. -->
    <AndroidAsset Include="$(GameContentDir)**" Link="Assets/Content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
