<Project>
  <!--
    Import from hosts that link SDL statically into the app executable (iOS, tvOS).

    The engine calls SDL through dlsym on the main program (Native/SDL.Resolver.cs), which the
    native linker can't see, so it would dead-strip those functions and leave them out of the
    exported symbol list. This tells the .NET for iOS linker to keep each one. The list is read from
    the engine's [LibraryImport] declarations so it can't drift. (Apple builds run on macOS only.)
  -->
  <Target Name="ReferenceEngineSdlSymbols" BeforeTargets="_ComputeLinkerInputs">
    <Exec Command="grep -oE 'static partial .*SDL_[A-Za-z0-9_]+\(' &quot;$(MSBuildThisFileDirectory)../Native/SDL.cs&quot; | grep -oE 'SDL_[A-Za-z0-9_]+' | sort -u"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="_EngineSdlImport" />
    </Exec>
    <Error Condition="'@(_EngineSdlImport)' == ''" Text="Found no SDL imports in Engine/Native/SDL.cs." />
    <ItemGroup>
      <ReferenceNativeSymbol Include="@(_EngineSdlImport)" SymbolType="Function" />
    </ItemGroup>
  </Target>
</Project>
