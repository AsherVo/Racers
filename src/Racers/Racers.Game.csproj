<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Racers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine\Engine.csproj" />
  </ItemGroup>

  <!--
    Maps each data ID to its group (the folder it sits in), ordered by Project.comp's rows, since not every platform
    can list Content folders at runtime. tools/DataGroups writes it; design-time builds reuse the last one.
  -->
  <Target Name="GenerateDataGroups" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <DataGroupsPath>$(IntermediateOutputPath)DataGroups.g.cs</DataGroupsPath>
    </PropertyGroup>

    <MSBuild Projects="$(MSBuildThisFileDirectory)../../tools/DataGroups/DataGroups.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishAot;_IsPublishing;TargetFramework;Platform"
             Condition="'$(DesignTimeBuild)' != 'true'" />

    <MSBuild Projects="$(MSBuildThisFileDirectory)../../tools/DataGroups/DataGroups.csproj" Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishAot;_IsPublishing;TargetFramework;Platform"
             Condition="'$(DesignTimeBuild)' != 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_DataGroupsTool" />
    </MSBuild>

    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;@(_DataGroupsTool)&quot; &quot;$(MSBuildThisFileDirectory)../../Project.comp&quot; &quot;$(DataGroupsPath)&quot;"
          StandardOutputImportance="low"
          Condition="'$(DesignTimeBuild)' != 'true'" />

    <ItemGroup>
      <Compile Include="$(DataGroupsPath)" Condition="Exists('$(DataGroupsPath)')" />
      <FileWrites Include="$(DataGroupsPath)" />
    </ItemGroup>
  </Target>

</Project>
